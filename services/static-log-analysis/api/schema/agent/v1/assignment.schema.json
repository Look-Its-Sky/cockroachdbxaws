{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/static-log-analysis/agent/v1/assignment.schema.json",
  "title": "Agent assignment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "message_id", "message_type", "created_at", "region",
    "tenant_id", "classification", "producer", "correlation_id", "incident_id",
    "incident_generation", "investigation_id", "service_id", "environment",
    "severity", "context_version"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^1\\.(0|[1-9][0-9]*)$"},
    "message_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "message_type": {"const": "agent.assignment.v1"},
    "created_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "region": {"$ref": "#/$defs/boundedIdentifier"},
    "tenant_id": {"$ref": "#/$defs/boundedIdentifier"},
    "classification": {"enum": ["PUBLIC", "INTERNAL", "SENSITIVE", "RESTRICTED"]},
    "producer": {"const": "static-log-analysis"},
    "correlation_id": {"$ref": "#/$defs/uuidv7"},
    "incident_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "incident_generation": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "investigation_id": {"$ref": "#/$defs/uuidv7"},
    "service_id": {"$ref": "#/$defs/boundedIdentifier"},
    "environment": {"$ref": "#/$defs/boundedIdentifier"},
    "severity": {"enum": ["unspecified", "trace", "debug", "info", "warn", "error", "fatal"]},
    "context_version": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807}
  },
  "$defs": {
    "boundedIdentifier": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:/-]+$"},
    "uuidv7": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}
  }
}
