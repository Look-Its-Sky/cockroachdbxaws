region    = "us-east-1"
tenant_id = "hackathon-production"

# Pin this to the commit you want the EC2 instance to build.
repository_ref = "Static-Log-Analysis"

# Create this SecureString before terraform apply. Never put its value here.
database_dsn_parameter_name = "/static-log-analysis/database-dsn"

cloudwatch_sources = {
  api = {
    log_group_arn  = "arn:aws:logs:us-east-1:111122223333:log-group:/aws/ecs/application/api"
    log_group_name = "/aws/ecs/application/api"
    service        = "api"
    environment    = "production"
  }
  worker = {
    log_group_arn  = "arn:aws:logs:us-east-1:111122223333:log-group:/aws/ecs/application/worker"
    log_group_name = "/aws/ecs/application/worker"
    service        = "worker"
    environment    = "production"
  }
}

tags = {
  Environment = "hackathon"
  Project     = "application"
}
