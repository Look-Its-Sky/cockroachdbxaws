{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["region", "tenantID", "allowedServices", "allowedEnvironments", "image", "database", "tls", "outbox"],
  "properties": {
    "region": {"type": "string", "pattern": "^[a-z]{2}(-gov)?-[a-z]+-[0-9]+$"},
    "tenantID": {"type": "string", "minLength": 1},
    "classification": {"type": "string", "minLength": 1},
    "redactionPolicy": {"type": "string", "minLength": 1},
    "allowedServices": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "allowedEnvironments": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "image": {
      "type": "object",
      "required": ["repository", "tag"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^(|sha256:[a-f0-9]{64})$"}
      }
    },
    "database": {
      "type": "object",
      "required": ["existingSecret", "dsnKey"],
      "properties": {
        "existingSecret": {"type": "string", "minLength": 1},
        "dsnKey": {"type": "string", "minLength": 1}
      }
    },
    "tls": {
      "type": "object",
      "required": ["analysisServerSecret", "collectorServerSecret", "collectorClientSecret", "analysisServerName"],
      "properties": {
        "analysisServerSecret": {"type": "string", "minLength": 1},
        "collectorServerSecret": {"type": "string", "minLength": 1},
        "collectorClientSecret": {"type": "string", "minLength": 1},
        "analysisServerName": {"type": "string"}
      }
    },
    "outbox": {
      "type": "object",
      "required": ["queueURL", "deadLetterQueueURL"],
      "properties": {
        "queueURL": {"type": "string", "pattern": "^https://sqs\\.[a-z0-9-]+\\.amazonaws\\.com/"},
        "deadLetterQueueURL": {"type": "string", "pattern": "^https://sqs\\.[a-z0-9-]+\\.amazonaws\\.com/"}
      }
    },
    "cloudwatch": {
      "type": "object",
      "required": ["enabled", "replicas", "accountID", "credentialIdentity", "sources"],
      "properties": {
        "enabled": {"type": "boolean"},
        "replicas": {"type": "integer", "minimum": 1, "maximum": 1},
        "accountID": {"type": "string", "pattern": "^(|[0-9]{12})$"},
        "credentialIdentity": {"type": "string"},
        "sources": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["logGroup", "service", "environment"],
            "properties": {
              "logGroup": {"type": "string", "pattern": "^[.\\-_/#A-Za-z0-9]+$"},
              "service": {"type": "string", "minLength": 1},
              "environment": {"type": "string", "minLength": 1}
            }
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"enabled": {"const": true}}},
          "then": {
            "properties": {
              "accountID": {"pattern": "^[0-9]{12}$"},
              "credentialIdentity": {"minLength": 1},
              "sources": {"minItems": 1}
            }
          }
        }
      ]
    }
  }
}
