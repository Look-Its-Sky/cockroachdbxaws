# Copy to .env and replace the three identity values for the repository being
# monitored. These are admission boundaries, not labels: records claiming a
# service or environment outside the lists are rejected.
SLA_REGION=us-east-1
SLA_TENANT_ID=local
SLA_ALLOWED_ENVIRONMENTS=development,staging,production
SLA_ALLOWED_SERVICES=example-service
SLA_SOURCE_ACCOUNT=local
SLA_SOURCE_INSTANCE=static-log-analysis-collector
SLA_CREDENTIAL_IDENTITY=local-compose
SLA_JOURNAL_MAX_BYTES=1073741824
SLA_JOURNAL_MIN_FREE_BYTES=67108864
SLA_INGRESS_NETWORK=static-log-analysis-ingress
SLA_OTLP_BIND_ADDRESS=127.0.0.1
SLA_OTLP_GRPC_PORT=4317
SLA_OTLP_HTTP_PORT=4318
SLA_ADMIN_PORT=9464
SLA_OUTBOX_ADMIN_PORT=9465
SLA_COCKROACH_SQL_PORT=26257
SLA_COCKROACH_HTTP_PORT=18080
SLA_LOCALSTACK_PORT=4566
