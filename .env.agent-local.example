# Copy to .env.agent-local. The populated file is ignored by Git.
#
# Choose either OpenRouter or self-hosted endpoints. For a model running on the
# Docker host, use host.docker.internal rather than localhost.

# OpenRouter:
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=cohere/north-mini-code:free
# OPENROUTER_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
# OPENROUTER_EMBEDDING_DIMENSIONS=1024

# Self-hosted chat and embeddings. These model names and the 768-wide vector
# were exercised together on a 16 GB NVIDIA GPU. compose.local-models.yaml
# overrides the URLs to host loopback; compose.local-integration.yaml uses the
# host-gateway values below.
OPENAI_BASE_URL=http://host.docker.internal:11434/v1
EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
OPENROUTER_MODEL=qwen2.5-coder:14b-instruct
OPENROUTER_EMBEDDING_MODEL=nomic-embed-text
VECTOR_DIMENSIONS=768

# Safe local defaults; change the token if the loopback binding is changed.
API_TOKEN=local-agent-token
AGENT_API_PORT=18081
SLA_REGION=us-east-1
SLA_TENANT_ID=local
